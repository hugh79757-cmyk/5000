#!/bin/bash

SITES=(
  "travel-hugo|/Users/twinssn/Projects/travel-hugo"
  "travel1-hugo|/Users/twinssn/Projects/travel1-hugo"
  "travel2-hugo|/Users/twinssn/Projects/travel2-hugo"
  "travel3-hugo|/Users/twinssn/Projects/travel3-hugo"
  "travel4-hugo|/Users/twinssn/Projects/travel4-hugo"
  "hotissue-hugo|/Users/twinssn/Projects/CAP/hotissue-hugo"
  "tco-hugo|/Users/twinssn/Projects/CAP/tco-hugo"
  "deal-hugo|/Users/twinssn/Projects/CAP/deal-hugo"
  "compare-hugo|/Users/twinssn/Projects/CAP/compare-hugo"
  "guide-hugo|/Users/twinssn/Projects/CAP/guide-hugo"
  "ev-hugo|/Users/twinssn/Projects/CAP/ev-hugo"
)

TIMESTAMP=$(date +"%Y-%m-%d %H:%M")
SUCCESS=0
SKIP=0
FAIL=0

echo "===== Wrangler 배치 배포 시작: $TIMESTAMP ====="
echo ""

for ENTRY in "${SITES[@]}"; do
  PROJECT="${ENTRY%%|*}"
  REPO="${ENTRY##*|}"
  NAME=$(basename "$REPO")
  echo "--- $NAME ---"

  if [ ! -d "$REPO" ]; then
    echo "  [SKIP] 디렉토리 없음"
    SKIP=$((SKIP + 1))
    echo ""
    continue
  fi

  cd "$REPO" || continue

  CHANGES=$(git status --porcelain 2>/dev/null)
  if [ -z "$CHANGES" ]; then
    echo "  [SKIP] 변경사항 없음"
    SKIP=$((SKIP + 1))
    echo ""
    continue
  fi

  FILE_COUNT=$(echo "$CHANGES" | wc -l | tr -d ' ')
  echo "  변경 파일: ${FILE_COUNT}개"

  git add -A
  git commit -m "publish: ${TIMESTAMP} 일괄 발행 (${FILE_COUNT}건)" --quiet

  echo "  Hugo 빌드 중..."
  if hugo --gc --minify --quiet; then
    echo "  [OK] 빌드 완료"
  else
    echo "  [FAIL] 빌드 실패"
    FAIL=$((FAIL + 1))
    echo ""
    continue
  fi

  echo "  Wrangler 배포 중..."
  if wrangler pages deploy ./public --project-name="$PROJECT" --branch=main --commit-dirty=true 2>&1 | tail -1; then
    echo "  [OK] 배포 완료"
    SUCCESS=$((SUCCESS + 1))
  else
    echo "  [FAIL] 배포 실패"
    FAIL=$((FAIL + 1))
  fi

  rm -rf ./public
  echo ""
done

echo "===== 결과 ====="
echo "  성공: ${SUCCESS}개"
echo "  스킵: ${SKIP}개 (변경없음)"
echo "  실패: ${FAIL}개"
echo "  CF 빌드 소모: 0회 (Direct Upload)"
