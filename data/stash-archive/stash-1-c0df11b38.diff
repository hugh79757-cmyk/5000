@@ -93,6 +93,70 @@ def save_deletion_log(deletions, dry_run=True):
     print(f"\n[LOG] Deletion log saved to: {LOG_FILE}")
 
 
+def rollback_deletions(blog=None, slug=None):
+    """
+    Restore posts from backup directory.
+    Supports --blog and --slug filters for partial rollback.
+    """
+    if not os.path.exists(LOG_FILE):
+        print(f"[ERROR] Deletion log not found: {LOG_FILE}")
+        return False
+    
+    with open(LOG_FILE, 'r', encoding='utf-8') as f:
+        log = yaml.safe_load(f)
+    
+    if not log:
+        print("[INFO] Deletion log is empty")
+        return True
+    
+    deletions = log.get('deletions', [])
+    success_deletions = [d for d in deletions if d.get('success', False)]
+    
+    if not success_deletions:
+        print("[INFO] No successful deletions to rollback")
+        return True
+    
+    # Apply filters
+    if blog:
+        success_deletions = [d for d in success_deletions if d.get('blog') == blog]
+    if slug:
+        success_deletions = [d for d in success_deletions if d.get('slug') == slug]
+    
+    if not success_deletions:
+        print("[INFO] No matching deletions to rollback")
+        return True
+    
+    print(f"[INFO] Rolling back {len(success_deletions)} deletions...")
+    
+    restored_count = 0
+    failed_count = 0
+    
+    for d in success_deletions:
+        backup_path = d.get('backup_path', '')
+        original_path = d.get('original_path', '')
+        
+        if not backup_path or not os.path.exists(backup_path):
+            print(f"  [WARN] Backup not found: {backup_path}")
+            failed_count += 1
+            continue
+        
+        try:
+            # Ensure original directory exists
