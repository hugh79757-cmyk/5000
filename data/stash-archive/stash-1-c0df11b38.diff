+    r"이미\s+(작성|전달|보내|드렸)",   # already written/sent
+    r"동일한\s+요청",                 # duplicate request
+    r"앞서\s+(전달|작성|말씀)",        # previously mentioned
+    r"다음과\s+같은\s+구조",           # structure outline
+    r"구조로\s+작성",                 # written in structure
+    r"언어\s+모델",                   # language model
+    r"AI\s+(언어\s+모델|모델)",        # AI model
+    r"As\s+an\s+AI",                  # English variant
+    r"수정.*(필요|원하시|있다면)",      # offering revision
+    r"다시\s+작성해\s+드리",           # offering rewrite
+]
+_META_RESPONSE_REGEX = [re.compile(p, re.IGNORECASE) for p in _META_RESPONSE_PATTERNS]
+
+
+def _is_meta_response(content: str) -> tuple[bool, str | None]:
+    """G1: AI 메타 응답 감지 (사과, 중복 언급, 재작성 제안 등).
+
+    Returns:
+        (is_meta, matched_pattern): 메타 응답이면 True와 매칭된 패턴 반환
+    """
+    if not content:
+        return False, None
+    for pattern in _META_RESPONSE_REGEX:
+        if pattern.search(content):
+            return True, pattern.pattern
+    return False, None
+
+
+def _normalize_paragraph(text: str) -> str:
+    """단락 비교용 정규화: 공백 축소, 후행 문장부호/괄호 제거, 소문자화."""
+    t = re.sub(r"\s+", " ", text).strip().lower()
+    t = t.rstrip(".!?,。！？，")
+    return t
+
+
+def _has_duplicate_intro(content: str, min_len: int = 50) -> tuple[bool, str | None]:
+    """
+    인접 단락이 정규화 후 동일하면 중복으로 판정.
+    반환: (is_duplicate, matched_snippet)
+    """
+    if not content:
+        return False, None
+    # HTML 태그 제거 후 단락 분할
+    clean_content = re.sub(r"<[^>]+>", "", content)
+    paragraphs = [p for p in clean_content.split("\n\n") if p.strip()]
+    for i in range(len(paragraphs) - 1):
+        a, b = _normalize_paragraph(paragraphs[i]), _normalize_paragraph(paragraphs[i+1])
+        if len(a) >= min_len and a == b:
+            return True, paragraphs[i][:80]
+    return False, None
+
+
+def is_truncated(body: str) -> bool:
+    """G2: 콘텐츠가 HTML 태그 중간에서 잘렸는지 검사.
+
+    마지막 100자에서 미닫기 태그 시작(<div, <p, <a, <h2, <h3, <span, <strong, <img, <br)을 찾음.
+    정상적인 콘텐츠는 닫는 태그(</p>, </div> 등)나 일반 텍스트로 끝나야 함.
+
+    Args:
+        body: HTML 본문
+
+    Returns:
+        True면 잘림(truncated) 의심
+    """
+    if not body or len(body) < 50:
+        return True  # 너무 짧으면 의심
+
+    tail = body[-100:].strip()
+    # 태그 시작인데 닫히지 않은 경우만 탐지 (닫는 태그 </ 는 제외)
+    truncation_pattern = re.compile(r'<(div|p|a|h[23]|span|strong|img|br)(\s[^>]*)?$')
+    return bool(truncation_pattern.search(tail))
+
+
+def has_min_heading_structure(body: str) -> bool:
+    """G3: 최소 헤딩 구조 검사 - H2 1개 이상 AND H3 2개 이상 필요.
+
+    HTML 태그(<h2>, <h3>)와 마크다운(##, ###) 둘 다 허용.
+    여행/맛집/코스 블로그는 구조화된 헤딩이 필수.
+
+    Args:
+        body: HTML 본문
+
+    Returns:
+        구조 요건 충족 시 True
+    """
+    if not body:
+        return False
+
+    # HTML 헤딩 검사
+    h2_count = len(re.findall(r'<h2\b', body, re.IGNORECASE))
+    h3_count = len(re.findall(r'<h3\b', body, re.IGNORECASE))
+
+    # 마크다운 헤딩도 검사 (AI가 마크다운 혼용 시 대비)
+    md_h2_count = len(re.findall(r'^##\s', body, re.MULTILINE))
+    md_h3_count = len(re.findall(r'^###\s', body, re.MULTILINE))
+
+    total_h2 = h2_count + md_h2_count
+    total_h3 = h3_count + md_h3_count
+
+    return total_h2 >= 1 and total_h3 >= 2
+
+
+# ── G1~G3 검증 통합 헬퍼 ──
+def _run_critical_guards(body: str) -> list:
+    """G1, G2, G3 크리티컬 가드 실행. 실패 시 CRITICAL 이슈 반환."""
+    issues = []
+
+    # G1: 메타 응답 감지
+    is_meta, pattern = _is_meta_response(body)
+    if is_meta:
+        issues.append(f"[CRITICAL] META_RESPONSE_DETECTED: {pattern}")
+
+    # G2: 잘림 감지
+    if is_truncated(body):
+        issues.append("[CRITICAL] TRUNCATED_CONTENT_DETECTED: HTML tag cutoff at end")
+
+    # G3: 최소 헤딩 구조
+    if not has_min_heading_structure(body):
+        issues.append("[CRITICAL] INSUFFICIENT_HEADING_STRUCTURE: need >=1 H2 and >=2 H3")
+
+    # G4: 도입부 중복 단락 감지
+    is_dup, snippet = _has_duplicate_intro(body)
+    if is_dup:
+        issues.append(f"[CRITICAL] DUPLICATE_INTRO_DETECTED: {snippet}...")
+
+    return issues
+
