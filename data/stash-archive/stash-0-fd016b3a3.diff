+def _improve_readability(text: str) -> str:
+    """가독성 개선: 긴 문장을 적절히 분할 (평균 80자 이하 목표)"""
+    import re
+    # 문장 단위로 분할 (한국어 종결어미 기준)
+    sentences = re.split(r'(?<=[.!?])\s+', text)
+    improved = []
+    for sent in sentences:
+        sent = sent.strip()
+        if not sent:
+            continue
+        # 문장이 120자 초과하면 분할 시도
+        if len(sent) > 120:
+            # 접속사/조사 기준으로 분할
+            parts = re.split(r'(?<=[,、])\s*|(?=\s+(?:그리고|하지만|그러나|따라서|또한|그래서|이에|때문에|하여|해서))', sent)
+            # 너무 세세하게 분할되지 않게 재조합
+            current = ""
+            for part in parts:
+                part = part.strip()
+                if not part:
+                    continue
+                if len(current) + len(part) <= 80:
+                    current += (" " if current else "") + part
+                else:
+                    if current:
+                        improved.append(current)
+                    current = part
+            if current:
+                improved.append(current)
+        else:
+            improved.append(sent)
+    return " ".join(improved)
+
+
+def _improve_readability_preserving_structure(md: str) -> str:
+    """마크다운 구조(테이블, HTML 블록, 코드 블록) 보존하며 텍스트 단락만 가독성 개선"""
+    import re
+
+    # 보호할 블록 패턴: 테이블, HTML div, 코드 블록
+    protected_blocks = []
+    block_patterns = [
+        (r'\|.*\|(?:\n\|.*\|)+', 'TABLE'),  # 마크다운 테이블
+        (r'<div[^>]*>.*?</div>', 'HTML_DIV'),  # HTML div 블록
+        (r'```.*?```', 'CODE'),  # 코드 블록
+        (r'`[^`]+`', 'INLINE_CODE'),  # 인라인 코드
+    ]
+
+    def protect_blocks(text):
+        for pattern, label in block_patterns:
+            matches = list(re.finditer(pattern, text, re.DOTALL))
+            for m in reversed(matches):  # 뒤에서부터 치환하여 인덱스 유지
+                placeholder = f"__PROTECTED_{label}_{len(protected_blocks)}__"
+                protected_blocks.append((placeholder, m.group(0)))
+                text = text[:m.start()] + placeholder + text[m.end():]
+        return text
+
+    def restore_blocks(text):
+        for placeholder, original in protected_blocks:
+            text = text.replace(placeholder, original)
+        return text
+
+    # 블록 보호
+    md_protected = protect_blocks(md)
+
+    # 문장 단위로 분할하여 가독성 개선 (보호된 블록은 건너뜀)
+    sentences = re.split(r'(?<=[.!?])\s+', md_protected)
+    improved = []
+    for sent in sentences:
+        sent = sent.strip()
+        if not sent:
+            continue
+        # 보호된 플레이스홀더가 포함된 문장은 그대로 유지
+        if '__PROTECTED_' in sent:
+            improved.append(sent)
+            continue
+        # 문장이 120자 초과하면 분할 시도
+        if len(sent) > 120:
+            parts = re.split(r'(?<=[,、])\s*|(?=\s+(?:그리고|하지만|그러나|따라서|또한|그래서|이에|때문에|하여|해서))', sent)
+            current = ""
+            for part in parts:
+                part = part.strip()
+                if not part:
+                    continue
+                if len(current) + len(part) <= 80:
+                    current += (" " if current else "") + part
+                else:
+                    if current:
+                        improved.append(current)
+                    current = part
+            if current:
+                improved.append(current)
+        else:
+            improved.append(sent)
+
+    result = " ".join(improved)
+    return restore_blocks(result)
+
