+### 수정안 1: score_product()에 "그램" brand 키워드 보너스
+
+`shared/relevance_scorer.py:22-26` 수정:
+
+```python
+# BEFORE
+def score_product(product_name: str, category_name: str, allowed_keywords: list[str]) -> float:
+    combined = (product_name + " " + category_name).lower()
+    count = sum(1 for kw in allowed_keywords if kw.lower() in combined)
+    min_matches = RELEVANCE_CONFIG["default"]["min_keyword_matches"]
+    return min(count / min_matches, 1.0)
+
+# AFTER
+BRAND_KEYWORDS = {"그램", "맥북", "갤럭시북", "씽크패드", "비보북", "젠북", "서피스", "크롬북"}
+
+def score_product(product_name: str, category_name: str, allowed_keywords: list[str]) -> float:
+    combined = (product_name + " " + category_name).lower()
+    count = 0
+    brand_hit = False
+    for kw in allowed_keywords:
+        if kw.lower() in combined:
+            count += 1
+            if kw in BRAND_KEYWORDS:
+                brand_hit = True
+    min_matches = RELEVANCE_CONFIG["default"]["min_keyword_matches"]
+    base = min(count / min_matches, 1.0)
+    # brand 키워드 매칭 시 보너스 (0.15) — threshold 0.65에서 0.50 제품도 통과 가능
+    if brand_hit and base < 1.0:
+        base = min(base + 0.15, 1.0)
+    return base
+```
