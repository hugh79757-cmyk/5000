/* ===== 모바일 좌우 흔들림 방지 (자동광고 호환) ===== */

/* body에만 overflow 적용 (html 제외 - 앵커광고 허용) */
body {
    overflow-x: hidden;
}

/* 메인 콘텐츠 영역만 제한 */
.main {
    overflow-x: hidden;
    max-width: 100%;
}

/* 헤더/네비게이션 */
.header,
.nav {
    overflow-x: hidden;
    max-width: 100%;
}

/* 테이블, 코드블록 등 넓은 요소 처리 */
.post-content pre,
.post-content table,
.post-content iframe {
    max-width: 100%;
    overflow-x: auto;
}

.post-content img {
    max-width: 100%;
    height: auto;
}

/* 광고 슬롯 - 자동광고 허용 */
.ad-slot,
ins.adsbygoogle,
.google-auto-placed {
    max-width: 100%;
    overflow: visible;
    box-sizing: border-box;
}

/* 포스트 엔트리 카드 */
.post-entry {
    max-width: 100%;
    overflow: hidden;
    box-sizing: border-box;
}

/* 푸터 */
.footer {
    overflow-x: hidden;
    max-width: 100%;
}

/* ===== 포스트 하단 빈 공간 제거 ===== */
.post-single {
    padding-bottom: 0;
    margin-bottom: 0;
}

.post-footer {
    margin-bottom: 0;
    padding-bottom: 20px;
}

.post-content {
    margin-bottom: 20px;
}

.main {
    padding-bottom: 20px;
    min-height: auto;
}

.footer {
    margin-top: 0;
    padding-top: 20px;
}

.paginav {
    margin-top: 20px;
    margin-bottom: 0;
}

.share-buttons {
    margin-bottom: 20px;
}

.post-tags {
    margin-bottom: 20px;
}

/* ===== 홈페이지 하단 빈 공간 제거 ===== */
.main {
    min-height: unset;
}

body.list {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

body.list .main {
    flex: 1;
    min-height: unset;
}

/* 푸터가 콘텐츠 바로 아래에 위치 */
.footer {
    margin-top: auto;
}

/* 페이지네이션 하단 여백 조정 */
.pagination {
    margin-bottom: 0;
}

/* 리스트 페이지 여백 */
.post-entry:last-child {
    margin-bottom: 0;
}

/* page-footer 여백 */
.page-footer {
    margin-bottom: 0;
    padding-bottom: 0;
}
