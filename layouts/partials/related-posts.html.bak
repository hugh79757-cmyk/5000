{{ $currentPage := . }}
{{ $allPages := where site.RegularPages "Kind" "page" }}
{{ $otherPages := where $allPages ".Permalink" "!=" $currentPage.Permalink }}
{{ $randomPages := $otherPages | shuffle | first 5 }}
{{ with $randomPages }}
<div class="related-posts" style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
  <h3 style="margin-bottom: 1rem; color: var(--primary);">함께 읽으면 좋은 글</h3>
  <ul style="list-style: none; padding: 0; margin: 0;">
    {{ range . }}
    <li style="margin-bottom: 0.8rem;">
      <a href="{{ .RelPermalink }}" style="color: var(--secondary); text-decoration: none;">
        {{ .Title }}
      </a>
    </li>
    {{ end }}
  </ul>
</div>
{{ end }}
