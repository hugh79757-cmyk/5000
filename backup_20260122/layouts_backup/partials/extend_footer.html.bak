{{- /* 광고 초기화 - 페이지당 1번만 실행 */ -}}
<script>
document.addEventListener('DOMContentLoaded', function() {
    var ads = document.querySelectorAll('ins.adsbygoogle');
    ads.forEach(function() {
        try {
            (adsbygoogle = window.adsbygoogle || []).push({});
        } catch(e) {}
    });
});
</script>
