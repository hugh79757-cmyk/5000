```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Database files
*.db

# Environment files
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
node_modules/

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Build directories
dist/
build/
target/

# Python cache
.mypy_cache/
.pytest_cache/
```